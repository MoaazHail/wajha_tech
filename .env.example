# Public site origin, used for canonical URLs, OG tags, robots and the sitemap.
NEXT_PUBLIC_SITE_URL

# WAJHA REST API (the `backend` folder), including the version prefix. Read server-side only.
# Page copy, plans, projects and contact details all come from here.
API_URL

# Comma-separated hosts allowed to serve next/image remote images.
CMS_IMAGE_HOSTS
